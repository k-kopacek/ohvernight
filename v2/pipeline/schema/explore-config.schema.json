{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["explore_version", "region_id", "initial_view", "layers", "capabilities", "official_links"],
  "properties": {
    "explore_version": {"const": 1},
    "region_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "initial_view": {
      "type": "object", "additionalProperties": false, "required": ["center", "zoom"],
      "properties": {
        "center": {"type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [{"type": "number", "minimum": -180, "maximum": 180}, {"type": "number", "minimum": -90, "maximum": 90}], "items": false},
        "zoom": {"type": "number", "minimum": 5, "maximum": 19}
      }
    },
    "layers": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["layer_id", "title", "order", "default_on", "min_zoom"],
      "properties": {
        "layer_id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1},
        "order": {"type": "number"}, "default_on": {"type": "boolean"},
        "min_zoom": {"type": ["number", "null"], "minimum": 5, "maximum": 19}
      }
    }},
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["trip_planner", "trail_search", "trail_season_check", "gpx_export", "saved_list", "adventure_pilot"],
      "properties": {
        "trip_planner": {"type": "boolean"}, "trail_search": {"type": "boolean"},
        "trail_season_check": {"type": "boolean"}, "gpx_export": {"type": "boolean"},
        "saved_list": {"type": "boolean"}, "adventure_pilot": {"type": "boolean"}, "region_extras": {"type": "boolean"}
      }
    },
    "official_links": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["label", "url"], "properties": {"label": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri", "pattern": "^https?://"}}}},
    "storage_keys": {"type": "object", "additionalProperties": false,
      "properties": {"trip": {"$ref": "#/$defs/storageKey"}, "plan": {"$ref": "#/$defs/storageKey"}, "notes": {"$ref": "#/$defs/storageKey"}}},
    "trip_defaults": {"type": "object", "additionalProperties": false,
      "properties": {"resort": {"type": "string"}, "arrive": {"type": "string", "format": "date"}, "depart": {"type": "string", "format": "date"},
        "vehicle": {"type": "string"}, "start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}, "activity": {"type": "string"}}},
    "landing": {"type": "object", "additionalProperties": false,
      "properties": {"eyebrow": {"type": "string"}, "title": {"type": "string"}, "lead": {"type": "string"}, "note": {"type": "string"},
        "explore_label": {"type": "string"},
        "region_links": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["label", "region_id"], "properties": {"label": {"type": "string", "minLength": 1}, "region_id": {"type": "string", "pattern": "^[a-z0-9-]+$"}}}},
        "mountains": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["value", "label"], "properties": {"value": {"type": "string"}, "label": {"type": "string"}}}}}},
    "export_names": {"type": "object", "additionalProperties": false,
      "properties": {"plan": {"type": "string", "pattern": "^[a-z0-9-]+\\.json$"}}}
  },
  "$defs": {"storageKey": {"type": "string", "pattern": "^[a-z0-9-]+$"}}
}
